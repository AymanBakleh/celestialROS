<?xml version="1.0" encoding="utf-8"?>
<robot name="telescope_description">
  <link name="world"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="/home/ayman/Jarspace/src/telescope_description/meshes/mount_base.STL" scale="1/10000 1/10000 1/10000"/>
      </geometry>
      <material name="base_material">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="/home/ayman/Jarspace/src/telescope_description/meshes/mount_base.STL" scale="1/10000 1/10000 1/10000"/>
      </geometry>
    </collision>
  </link>

  <joint name="fixed_link" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="-688 415 1200" rpy="3.14159 0 0"/>
  </joint>


  <link name="polar_align_link">
    <inertial>
      <origin xyz="18 -55 -15" rpy="0 0 1.570795"/>
      <mass value="0.5"/>
      <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
