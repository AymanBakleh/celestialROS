        <mesh filename="/home/ayman/Jarspace/src/telescope_description/meshes/mount_link_1.STL"/>
      </geometry>
      <material name="mount_material">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="18 -55 -15" rpy="0 0 1.570795"/>
      <geometry>
        <mesh filename="/home/ayman/Jarspace/src/telescope_description/meshes/mount_link_1.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="polar_align_joint" type="revolute">
    <parent link="base_link"/>
    <child link="polar_align_link"/>
    <origin xyz="682 420 30" rpy="0 3.14159 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="1.570795" effort="1000.0" velocity="0.1"/>
  </joint>



  <link name="ra_link">
